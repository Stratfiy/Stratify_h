{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "NAutomation Labs design tokens",
    "version": "1.0.0",
    "sourceOfTruth": "nautomation-web/tokens.json — decibyl-web copies this file; change it here first."
  },
  "color": {
    "surface":   { "light": "#F7F6F2", "dark": "#141413" },
    "panel":     { "light": "#FFFFFF", "dark": "#1E1E1C" },
    "border":    { "light": "#E4E2DA", "dark": "#2C2C2A" },
    "ink":       { "light": "#141413", "dark": "#F7F6F2" },
    "ink-2":     { "light": "#5A5955", "dark": "#B4B2AB" },
    "ink-3":     { "light": "#6F6E69", "dark": "#8F8E88" },
    "accent":    { "light": "#26215C", "dark": "#B9B3F2" },
    "accent-2":  { "light": "#534AB7", "dark": "#8F86E6" },
    "done":      { "light": "#0F6E56", "dark": "#5FCBA8" },
    "done-soft": { "light": "#E4F3EE", "dark": "#123A30" },
    "ask":       { "light": "#D85A30", "dark": "#F29B7B" },
    "ask-soft":  { "light": "#FBE9E1", "dark": "#43261B" }
  },
  "font": {
    "display": "'Instrument Serif', Georgia, 'Times New Roman', serif",
    "body": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "radius": { "sm": "8px", "md": "12px", "pill": "999px" },
  "grid": { "base": "4px" },
  "border": { "width": "1px", "policy": "1px borders over shadows" },
  "motion": { "fast": "150ms", "base": "200ms", "slow": "250ms", "easing": "cubic-bezier(0.2, 0, 0, 1)", "reducedMotion": "respected" },
  "breakpoints": { "mobile": "390px", "desktop": "1440px" }
}
