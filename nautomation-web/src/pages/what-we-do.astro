---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CTABand from '@/components/CTABand.astro';
const crumbs = [{ name: 'What we do', path: '/what-we-do' }];
const families = [
  { title: 'Follow-ups', lead: 'Quotes, invoices, appointments and documents, chased until they’re done.',
    before: 'A sales coordinator spends Friday afternoons re-sending quote reminders to twelve prospects and forgets two.',
    after: 'The agent sends the reminder on day 3 and day 7 from the coordinator’s own mailbox, in her tone, and stops when a reply lands.',
    record: '12 reminders sent, 2 replies, 1 meeting booked, each with a time and the sent copy.' },
  { title: 'Vendor coordination', lead: 'RFQs sent, quotes compared, deliveries tracked, invoices matched.',
    before: 'A buyer emails three vendors for a quote, chases by phone, and builds the comparison in a spreadsheet after hours.',
    after: 'The agent drafts the RFQ (approved once), sends it, calls the vendors that don’t reply, and puts the three quotes in one table.',
    record: 'RFQ approved by the buyer at 09:47, 3 sent, 2 calls with transcripts, comparison table, recommendation awaiting the PO decision.' },
  { title: 'Front desk', lead: 'Calls and messages answered in your language, with a record.',
    before: 'A clinic misses a third of its calls during lunch and the receptionist writes appointment requests on sticky notes.',
    after: 'The agent answers in Tamil or English, introduces itself as an AI assistant, books into the calendar, and asks first for anything unusual.',
    record: 'Every call: who called, what they wanted, what was booked, and the audio.' },
  { title: 'Back office', lead: 'Reminders, reports and data entry between the tools you already use.',
    before: 'Someone copies numbers from the bank export into the accounting tool every Monday and the weekly report is always late.',
    after: 'The agent moves the data, flags what doesn’t match, and sends the report draft for a two-minute approval.',
    record: '184 rows entered, 3 mismatches flagged, report approved by the owner Monday 10:12.' },
];
---
<Base title="What we do — work done through AI agents | NAutomation Labs" description="Follow-ups, vendor coordination, front desk and back office: work we get done through AI agents we set up and run, with approvals and a record of every action." path="/what-we-do" crumbs={crumbs}>
  <PageHero eyebrow="What we do" title="We get the work done, through AI agents we set up and run." sub="Four kinds of work. Each one from your own email, WhatsApp and apps, with a person approving what matters and a record of every action." crumbs={crumbs} />

  <section class="wrap pb-16 sm:pb-24">
    <div class="grid gap-6 lg:grid-cols-2">
      {families.map((f) => (
        <article class="card">
          <h2 class="text-3xl">{f.title}</h2>
          <p class="mt-2 text-ink-2">{f.lead}</p>
          <dl class="mt-6 space-y-4 text-[15px]">
            <div class="grid grid-cols-[72px_1fr] gap-3"><dt class="text-xs font-medium uppercase tracking-wider text-ink-3 pt-1">Before</dt><dd class="text-ink-2">{f.before}</dd></div>
            <div class="grid grid-cols-[72px_1fr] gap-3"><dt class="text-xs font-medium uppercase tracking-wider text-accent-2 pt-1">After</dt><dd class="text-ink">{f.after}</dd></div>
            <div class="grid grid-cols-[72px_1fr] gap-3"><dt class="text-xs font-medium uppercase tracking-wider text-done pt-1">Record</dt><dd class="text-ink-2">{f.record}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-line bg-panel">
    <div class="wrap section grid gap-8 lg:grid-cols-[1fr_2fr]">
      <div><p class="eyebrow">What we don't do</p></div>
      <ul class="space-y-4 text-lg text-ink">
        <li class="flex gap-3"><span class="text-ask" aria-hidden="true">✕</span> Custom one-off software. We set up and run agents that do defined work; we don't build bespoke systems you then have to maintain.</li>
        <li class="flex gap-3"><span class="text-ask" aria-hidden="true">✕</span> Anything without a record. If it can't be logged and exported, we don't run it.</li>
        <li class="flex gap-3"><span class="text-ask" aria-hidden="true">✕</span> Anything that sends, spends or deletes without approval. A named person says yes first.</li>
      </ul>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">The path</p>
    <p class="mt-3 display text-2xl sm:text-3xl max-w-3xl">Free proof of value on your data → 90-day pilot on one task → run monthly with a scorecard → expand from day 90. <a href="/how-it-works" class="link">How it works</a>.</p>
  </section>
  <CTABand />
</Base>
