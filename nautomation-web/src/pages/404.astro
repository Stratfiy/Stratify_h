---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found — NAutomation Labs" description="That page isn't here. Try what we do, procurement, Decibyl or contact." path="/404" noindex noWaitlist>
  <section class="wrap section">
    <p class="eyebrow">404</p>
    <h1 class="mt-3">That page isn't on the record.</h1>
    <p class="mt-6 lede max-w-xl">The site was rebuilt in October 2026 and some old links moved. Try one of these.</p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 max-w-2xl">
      {[['/', 'Home'], ['/what-we-do', 'What we do'], ['/procurement', 'Procurement & logistics teams'], ['/decibyl', 'Decibyl'], ['/how-it-works', 'How it works'], ['/contact', 'Book a proof of value']].map(([h, l]) => <li><a href={h} class="card block hover:border-accent-2 transition-colors duration-200">{l} →</a></li>)}
    </ul>
  </section>
</Base>
