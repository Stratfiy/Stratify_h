---
/** Native <details> accordion — no JS needed. Pair with faqPage() schema in the page. */
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions people ask' } = Astro.props;
---
<section class="wrap section" aria-labelledby="faq-h">
  <div class="grid gap-8 lg:grid-cols-[1fr_2fr]">
    <div><p class="eyebrow">FAQ</p><h2 id="faq-h" class="mt-3">{title}</h2></div>
    <div class="divide-y divide-line border-y border-line">
      {items.map((it) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-medium text-ink">
            {it.q}
            <span class="shrink-0 text-ink-3 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-ink-2 leading-relaxed">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
