---
interface Props { class?: string }
const { class: cls = 'w-full h-auto' } = Astro.props;
---
<svg class={cls} viewBox="0 0 360 240" role="img" aria-label="Completed task card: three quotes compared, on record" font-family="Inter Variable, Inter, system-ui, sans-serif">
  <rect x="0.5" y="0.5" width="359" height="239" rx="12" fill="var(--surface)" stroke="var(--border)"/>
  <rect x="20" y="20" width="320" height="200" rx="10" fill="var(--panel)" stroke="var(--border)"/>
  <circle cx="48" cy="48" r="12" fill="var(--done-soft)"/>
  <path d="m42.5 48.5 3.6 3.6 7.4-7.6" fill="none" stroke="var(--done)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="68" y="45" font-size="14" font-weight="600" fill="var(--ink)">Quotes compared</text>
  <text x="68" y="60" font-size="11" fill="var(--ink-3)">Done · 15:30 · 6 actions on record</text>
  <rect x="36" y="76" width="288" height="1" fill="var(--border)"/>
  <text x="36" y="98" font-size="10" fill="var(--ink-3)">VENDOR</text><text x="180" y="98" font-size="10" fill="var(--ink-3)">₹/KG</text><text x="240" y="98" font-size="10" fill="var(--ink-3)">LEAD</text><text x="300" y="98" font-size="10" fill="var(--ink-3)">TERMS</text>
  <text x="36" y="120" font-size="12" fill="var(--ink)">Arvind Steels</text><text x="180" y="120" font-size="12" fill="var(--ink)">212</text><text x="240" y="120" font-size="12" fill="var(--ink)">9 d</text><text x="300" y="120" font-size="12" fill="var(--ink)">30 d</text>
  <rect x="30" y="130" width="300" height="24" rx="6" fill="var(--done-soft)"/>
  <text x="36" y="146" font-size="12" font-weight="600" fill="var(--ink)">Metco</text><text x="180" y="146" font-size="12" font-weight="600" fill="var(--ink)">204</text><text x="240" y="146" font-size="12" font-weight="600" fill="var(--ink)">7 d</text><text x="300" y="146" font-size="12" font-weight="600" fill="var(--ink)">45 d</text>
  <text x="36" y="172" font-size="12" fill="var(--ink)">Sri Balaji Alloys</text><text x="180" y="172" font-size="12" fill="var(--ink)">209</text><text x="240" y="172" font-size="12" fill="var(--ink)">12 d</text><text x="300" y="172" font-size="12" fill="var(--ink)">30 d</text>
  <rect x="36" y="184" width="288" height="1" fill="var(--border)"/>
  <text x="36" y="206" font-size="11" fill="var(--ink-2)">Recommendation sent to R. Menon for the PO decision. Nothing ordered yet.</text>
</svg>
