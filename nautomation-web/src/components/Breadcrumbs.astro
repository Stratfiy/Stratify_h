---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-ink-3">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover:text-ink">Home</a></li>
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5"><span aria-hidden="true">/</span>{i === items.length - 1 ? <span aria-current="page" class="text-ink-2">{it.name}</span> : <a href={it.path} class="hover:text-ink">{it.name}</a>}</li>
    ))}
  </ol>
</nav>
