---
import Logo from './Logo.astro';
import { NAV, SITE } from '@/lib/site';
interface Props { currentPath: string }
const { currentPath } = Astro.props;
---
<header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 font-medium text-ink">
      <Logo />
      <span class="text-[15px] tracking-tight">NAutomation Labs</span>
    </a>
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-1">
      {NAV.map((n) => (
        <a href={n.href} aria-current={currentPath === n.href || currentPath.startsWith(n.href + '/') ? 'page' : undefined}
          class="rounded-[8px] px-3 py-2 text-sm text-ink-2 hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-panel transition-colors duration-150">{n.label}</a>
      ))}
    </nav>
    <div class="hidden lg:flex items-center gap-2">
      <button type="button" id="theme-toggle" class="btn-ghost !px-2.5" aria-label="Toggle dark mode" title="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.5 0-1-.1-1.4A6.5 6.5 0 0 1 12 3Z"/></svg>
      </button>
      <a href="/contact" class="btn-primary !py-2" data-cta="nav_book_pov">Book a proof of value</a>
    </div>
    <details class="lg:hidden relative">
      <summary class="btn-secondary !py-2 !px-3 list-none cursor-pointer" aria-label="Open menu">Menu</summary>
      <div class="absolute right-0 mt-2 w-64 card p-2 shadow-none">
        <nav aria-label="Mobile" class="flex flex-col">
          {NAV.map((n) => <a href={n.href} class="rounded-[8px] px-3 py-2 text-sm text-ink hover:bg-surface">{n.label}</a>)}
          <a href="/careers" class="rounded-[8px] px-3 py-2 text-sm text-ink hover:bg-surface">Careers</a>
          <a href="/contact" class="btn-primary mt-2 !py-2" data-cta="nav_book_pov">Book a proof of value</a>
          <a href={SITE.decibylSignup} class="btn-secondary mt-2 !py-2" data-cta="nav_decibyl_signup">Start free on Decibyl</a>
        </nav>
      </div>
    </details>
  </div>
</header>
<script>
  const b = document.getElementById('theme-toggle');
  b?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.getAttribute('data-theme') === 'dark' || (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
