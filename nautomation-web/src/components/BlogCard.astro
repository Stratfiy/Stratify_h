---
interface Props { slug: string; title: string; description: string; date: Date; tags?: string[] }
const { slug, title, description, date, tags = [] } = Astro.props;
const d = date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class="card flex h-full flex-col">
  <p class="text-xs text-ink-3"><time datetime={date.toISOString()}>{d}</time></p>
  <h3 class="mt-3 !font-sans text-xl font-semibold !leading-snug"><a href={`/blog/${slug}`} class="hover:text-accent">{title}</a></h3>
  <p class="mt-2 flex-1 text-ink-2">{description}</p>
  {tags.length > 0 && <p class="mt-4 flex flex-wrap gap-1.5">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
</article>
