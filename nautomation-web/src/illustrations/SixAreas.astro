---
interface Props { class?: string }
const { class: cls = 'w-full h-auto' } = Astro.props;
const areas = [
  { n: "Founder's Office & Ops", r: ['CEO', 'Chief of Staff'] },
  { n: 'Studio', r: ['Agent Engineers', 'Delivery Lead'] },
  { n: 'Product & Engineering', r: ['Senior Full-Stack Engineer', 'DevRel Intern'] },
  { n: 'Growth & Marketplace', r: ['Head of Growth', 'Content & Social Media'] },
  { n: 'Sales & Partnerships', r: ['Business Development Rep', 'Partnerships'] },
  { n: 'Finance, Legal & People', r: ['Finance (CA, external)', 'People Ops'] },
];
---
<svg class={cls} viewBox="0 0 720 300" role="img" aria-label="The six areas of NAutomation Labs with role titles" font-family="Inter Variable, Inter, system-ui, sans-serif">
  <rect x="285" y="12" width="150" height="40" rx="8" fill="var(--accent)"/>
  <text x="360" y="37" text-anchor="middle" font-size="13" font-weight="600" fill="var(--on-accent)">NAutomation Labs</text>
  <path d="M360 52v20M60 72h600M60 72v18M180 72v18M300 72v18M420 72v18M540 72v18M660 72v18" stroke="var(--border)" stroke-width="1.5" fill="none"/>
  {areas.map((a, i) => (
    <g transform={`translate(${6 + i * 120} 90)`}>
      <rect x="0.5" y="0.5" width="107" height="196" rx="10" fill="var(--panel)" stroke="var(--border)"/>
      <foreignObject x="10" y="10" width="88" height="176">
        <div style="font-size:11.5px;line-height:1.3;color:var(--ink);">
          <div style="font-weight:600;min-height:32px;">{a.n}</div>
          <div style="height:1px;background:var(--border);margin:8px 0;"></div>
          {a.r.map((role) => <div style="color:var(--ink-2);margin-top:6px;">{role}</div>)}
        </div>
      </foreignObject>
    </g>
  ))}
</svg>
